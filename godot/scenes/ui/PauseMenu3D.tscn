text = "[b][color=#FFD166]MYTHOS CONTROL SCHEMES & SHORTCUTS[/color][/b]

[table=3]
[cell][b][color=#38BDF8]ACTION[/color][/b][/cell][cell][b][color=#FFB703]KEYBOARD & MOUSE[/color][/b][/cell][cell][b][color=#10B981]GAMEPAD CONTROLLER[/color][/b][/cell]
[cell]Movement / Walk[/cell][cell][W] [A] [S] [D][/cell][cell]Left Analog Stick [L-Stick][/cell]
[cell]Haste / Sprint[/cell][cell]Hold [SHIFT] while moving[/cell][cell]Press [L3] or Hold [RT][/cell]
[cell]Camera Orbit / Pitch[/cell][cell]Mouse Motion / Right Click Drag[/cell][cell]Right Analog Stick [R-Stick][/cell]
[cell]Camera Zoom[/cell][cell]Mouse Scroll Wheel[/cell][cell]D-Pad Up / Down[/cell]
[cell]Jump / Mantle[/cell][cell][SPACE][/cell][cell][A / Cross Button][/cell]
[cell]Prana Dash (Dodge)[/cell][cell][SHIFT] or [F][/cell][cell][B / Circle Button][/cell]
[cell]Surya Combo Slash[/cell][cell]Left Click [LMB][/cell][cell][X / Square Button][/cell]
[cell]Surya Shield Guard[/cell][cell]Hold [Q] or [C][/cell][cell]Hold Left Bumper [LB / L1][/cell]
[cell]Parry Deflection[/cell][cell]Press [F] at impact[/cell][cell]Right Bumper [RB / R1][/cell]
[cell]Combat Lock-On[/cell][cell][TAB] or Middle-Click[/cell][cell]Press [R3] (Right Stick)[/cell]
[cell]Commune / Interact[/cell][cell][E] or [ENTER][/cell][cell][Y / Triangle Button][/cell]
[cell]Over-The-Shoulder View[/cell][cell][C][/cell][cell]D-Pad Left[/cell]
[cell]Pause Menu / Journal[/cell][cell][ESC] or [P][/cell][cell]Start / Menu Button[/cell]
[cell]Toggle Controls Overlay[/cell][cell][H][/cell][cell]Select / Back Button[/cell]
[/table]
"
