{
  "name": "mythos-astra-game",
  "version": "0.1.0",
  "description": "Mythos: Astra & The Seven Realms - Production-Grade Cross-Platform Mythological Game Engine & Foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify:append-only": "node scripts/verify-append-only.js",
    "build:platforms": "node scripts/build-platforms.js",
    "validate:artifacts": "node scripts/validate-artifacts.js",
    "generate:sbom": "node scripts/generate-sbom.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "game-engine",
    "mythological",
    "cross-platform",
    "typescript",
    "canvas",
    "webgl",
    "stage-0"
  ],
  "author": "Mythos Core Architecture Team",
  "license": "Apache-2.0"
}
